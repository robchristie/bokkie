#!/usr/bin/env bash
# The canonical verification. CI runs exactly this.
#
# Set BOKKIE_SKIP_LIVE=1 to skip downloading Codex and the live checks,
# including the browser smoke.
# The web client's tools (the pinned `stobie` CLI and `wasm-bindgen`) are
# always installed, into ignored `.tools/`.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

if [[ "${BOKKIE_SKIP_LIVE:-}" != 1 ]]; then
  BOKKIE_CODEX_BIN="$(scripts/fetch-codex)"
  export BOKKIE_CODEX_BIN
fi
web_tools="$(scripts/fetch-stobie)"

cargo fmt --all --check
cargo clippy --workspace --all-targets --locked -- --deny warnings
cargo test --workspace --locked
# The wire types and the web client's core run in the browser too.
cargo build -p bokkie-protocol -p bokkie-web --target wasm32-unknown-unknown --locked
# The web client's browser-only code, then its web root and a production
# package with the pinned tools. Both must carry the fonts' notices.
cargo clippy -p bokkie-web --target wasm32-unknown-unknown --locked -- --deny warnings
web_package="$(mktemp -d)"
trap 'rm -rf -- "$web_package"' EXIT
PATH="$web_tools:$PATH" stobie build-web --manifest-path apps/bokkie-web/Cargo.toml \
  --package bokkie-web --locked
PATH="$web_tools:$PATH" stobie build-web --manifest-path apps/bokkie-web/Cargo.toml \
  --package bokkie-web --locked --production --output "$web_package" >/dev/null
scripts/check-web-notices apps/bokkie-web/web "$web_package"/bokkie-web/assets/*/
# The committed icons are the mark's rendering.
scripts/render-icons --check
# That package, served by the real gateway with the pinned Codex and the
# mock model, in headful Chromium.
if [[ "${BOKKIE_SKIP_LIVE:-}" != 1 ]]; then
  scripts/browser-smoke "$web_package/bokkie-web"
fi
if command -v shellcheck >/dev/null; then
  # Shell scripts: every *.sh, and the scripts/ files with a shell shebang.
  mapfile -t shell_scripts < <(
    git ls-files '*.sh'
    git ls-files 'scripts/*' | while read -r script; do
      if head -n 1 "$script" | grep -qE '^#!(/usr/bin/env |/bin/)(ba)?sh$'; then
        echo "$script"
      fi
    done
  )
  shellcheck "${shell_scripts[@]}"
elif [[ -n "${CI:-}" ]]; then
  echo "verify: shellcheck is required in CI" >&2
  exit 1
else
  echo "verify: shellcheck is not installed; skipping shell lint" >&2
fi
# Every action is pinned by full commit SHA, with its version in a comment.
if unpinned="$(git ls-files -z '.github/workflows/*' |
  xargs -0 grep -nE '^[[:space:]-]*uses:' |
  grep -vE 'uses:[[:space:]]*(\./|[^@[:space:]]+@[0-9a-f]{40}[[:space:]]+#[[:space:]]*v[0-9])')"; then
  echo "verify: pin every action by commit SHA with a version comment:" >&2
  echo "$unpinned" >&2
  exit 1
fi
git diff --exit-code -- Cargo.lock
