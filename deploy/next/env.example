# Copy to .env beside compose.yml and fill in. .env stays on the host and is
# never committed.

# The hostname Traefik routes to the gateway. The origin is https://<host>.
BOKKIE_NEXT_HOST=bokkie-next.example.lan
# The full commit the running image was built from (build.sh tags the image
# bokkie-next:<commit>).
BOKKIE_NEXT_REVISION=
